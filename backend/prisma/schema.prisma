// Prisma schema - defines the structure of our PostgreSQL database.
//
// Data flow:
// schema.prisma
//      ↓
// Prisma Migrate
//      ↓
// PostgreSQL (Supabase)
//      ↓
// Prisma Client
//      ↓
// Express API

// Generates Prisma Client for database queries
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// PostgreSQL — connection URL lives in prisma.config.ts (Prisma 7+)
datasource db {
  provider = "postgresql"
}

model User {
  id           String       @id
  email        String       @unique
  createDate   DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  repositories Repository[]
  goals        Goal[]
}

enum GoalStatus {
  active
  archived
}

model Goal {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  name          String
  weight        Int
  deadline      DateTime?
  nextAction    String
  status        GoalStatus @default(active)
  lastTouchedAt DateTime   @default(now())
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Ordered steps/topics under this goal
  subPlans PlanStep[]
}

model Repository {
  // Primary key - uniquely identifies the Repository
  id String @id

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Repository name
  name String

  // Repository Owner name
  owner String

  // URL of the repository on Github
  url String

  //When the repository was added - in case none is provided then use the current datetime stamp
  createdAt DateTime @default(now())

  //commits made on the repository
  commits Commit[]
}

// Commit model
model Commit {
  // Primary key for the commit records
  id String @id

  // Foreign Key connecting the commits to the repository
  repositoryId String

  // Connects Commit.repositoryId → Repository.id.
  repository Repository @relation(fields: [repositoryId], references: [id])

  // Git commit SHA value
  sha String @unique

  // Number of lines added in the commit
  additions Int

  //Number of line deleted in the commit
  deletions Int

  // When the commit was actually made
  committedAt DateTime

  // URL of the commit on Github
  url String

  //When this commit was added to our db
  createdAt DateTime @default(now())
}

enum PlanStepStatus {
  todo
  doing
  done
  skipped
  archived // hidden from the plan; row stays until a later purge
}

// Ordered step/topic under a goal (plan pointer = first not done/skipped)
model PlanStep {
  id     String @id @default(cuid()) // this step’s id
  goalId String // FK only — not unique alone; one goal owns many steps
  goal   Goal   @relation(fields: [goalId], references: [id]) // Goal ↔ GoalPlanStep

  title         String // step title
  sortOrder     Int // position in the plan (0, 1, 2, …)
  status        PlanStepStatus @default(todo) // todo | doing | done | skipped | archived
  startedAt     DateTime? // when work on this step began
  createdAt     DateTime       @default(now()) // when the row was created
  lastupdatedAt DateTime       @updatedAt // last row update
  archivedAt    DateTime? // when the step was archived

  // Unique as a pair: many steps per goalId, but each sortOrder only once per goal
  @@unique([goalId, sortOrder])
}
